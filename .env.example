# Painel Server10 — modelo de configuração. NÃO coloque valores reais neste arquivo.
# No servidor, copie para /etc/painel-server10/painel.env (dono root, permissão 0600).
# O systemd carrega o arquivo para os serviços; a interface web não o lê diretamente.

# --- Web e login administrativo -------------------------------------------
# Gere com: python -m painel.manage gen-secret
SECRET_KEY=
ADMIN_USER=admin
# Gere com: python -m painel.manage hash-password  (cole entre aspas simples)
ADMIN_PASSWORD_HASH=''
# false = painel exige login (recomendado); true = leitura sem login na rede interna
PUBLIC_DASHBOARD=false
# true quando servido por HTTPS (padrão da instalação)
SESSION_COOKIE_SECURE=true
# Endereço exibido nos e-mails, ex.: https://<nome-ou-ip-do-servidor>:8443
PANEL_URL=
DB_PATH=/var/lib/painel-server10/painel.db

# --- SMTP (opcional; sem ele o painel mostra "E-mail não configurado") ------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false

# --- Ferramentas de leitura de hardware (usadas apenas pelo coletor root) ---
MEGACLI_PATH=/opt/MegaRAID/MegaCli/MegaCli64
# Diretório de bibliotecas legadas exigidas pelo MegaCLI, se houver
MEGACLI_LIBDIR=
SMARTCTL_PATH=/usr/sbin/smartctl
SMART_DEVICE=/dev/sda
SMART_DISK_IDS=0,1
IPMITOOL_PATH=/usr/bin/ipmitool

# Linha de base dos contadores SMART já conhecidos (sem isso, a primeira coleta vira a base).
# Formato: <id>:contador=valor,...;<id>:...
# Contadores: grown_defects, read_uncorrected, write_uncorrected, verify_uncorrected, non_medium
SMART_BASELINE=

# --- Limites (opcionais) ---------------------------------------------------
RAID_EXPECTED_VD=1
STALE_MINUTES=15
FS_WARN_PERCENT=80
FS_CRIT_PERCENT=90
AMBIENT_WARN_C=35
AMBIENT_CRIT_C=40
FAN_MIN_RPM=1000
COMMAND_TIMEOUT=90
SNAPSHOT_RETENTION_DAYS=7
