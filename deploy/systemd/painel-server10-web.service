[Unit]
Description=Painel Server10 - interface web (HTTPS, sem privilégios)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=painel
Group=painel
UMask=0007
EnvironmentFile=/etc/painel-server10/painel.env
WorkingDirectory=/opt/painel-server10
ExecStart=/opt/painel-server10/venv/bin/gunicorn --workers 1 --threads 4 \
    --bind 0.0.0.0:8443 \
    --certfile /etc/painel-server10/tls/painel.crt \
    --keyfile /etc/painel-server10/tls/painel.key \
    --access-logfile - \
    "painel.web:create_app()"
Restart=on-failure
RestartSec=5

# Endurecimento: o processo web só lê/grava o banco do painel
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/painel-server10

[Install]
WantedBy=multi-user.target
